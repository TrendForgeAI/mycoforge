# AI Provider Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# GitHub
# Benötigte Scopes: repo, workflow, read:org
GH_TOKEN=
GH_ORG=
GIT_USER_NAME=
GIT_USER_EMAIL=

# mycoforge Einstellungen
# DEBUG_MODE: on = Agent/Provider/Modell bei jedem Task anzeigen
DEBUG_MODE=off
# SWARM_MAX_ITERATIONS: Maximale Iterationen pro /explore Lauf (default 3, empfohlen: 2-5)
# Kann beim Aufruf mit --iterations N überschrieben werden
SWARM_MAX_ITERATIONS=3
